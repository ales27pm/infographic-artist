HOST=127.0.0.1
PORT=8000
# Production origin used in widget metadata, e.g. https://brand-atlas.example.com
APP_BASE_URL=
# Optional DNS-rebinding protection allowlists. Comma-separated.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
CORS_ALLOW_ORIGINS=https://chatgpt.com,https://chat.openai.com,https://platform.openai.com
# Leave empty until the OpenAI portal issues the exact domain-verification token.
OPENAI_APPS_CHALLENGE_TOKEN=

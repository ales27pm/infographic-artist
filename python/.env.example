HOST=127.0.0.1
PORT=8000
# Production origin used in widget metadata, e.g. https://brand-atlas.example.com
APP_BASE_URL=
# Optional DNS-rebinding protection allowlists. Comma-separated.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
CORS_ALLOW_ORIGINS=https://chatgpt.com,https://chat.openai.com,https://platform.openai.com
# Leave empty until the OpenAI portal issues the exact domain-verification token.
OPENAI_APPS_CHALLENGE_TOKEN=
# Required for live plugin-side rendering when IMAGE_GENERATION_PROVIDER=openai.
OPENAI_API_KEY=<set-in-deployment-for-live-rendering>
IMAGE_GENERATION_PROVIDER=openai
IMAGE_GENERATION_MODEL=gpt-image-2
IMAGE_GENERATION_TIMEOUT_SECONDS=120
GENERATED_ASSET_DIR=generated_assets
GENERATED_ASSET_RETENTION_HOURS=168
GENERATED_ASSET_MAX_BYTES=536870912
RENDER_MAX_CONCURRENT_JOBS=2
RENDER_DAILY_IMAGE_LIMIT=25
